# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Apenas a chave ANON/publishable vai no front —
# NUNCA a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
VITE_API_URL=http://localhost:8080/api
# Opcional: chave da Google Maps JavaScript API para renderizar o Google Maps nativo na tela de acompanhamento.
# Sem esta chave, o mapa já funciona gratuitamente com OpenStreetMap + Satélite (Esri) + rotas reais OSRM.
VITE_GOOGLE_MAPS_API_KEY=
