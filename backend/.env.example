# Copie para backend/.env — o Spring lê este arquivo automaticamente. NUNCA commite o arquivo real.

# --- Supabase > Project Settings > API ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Só para projetos com "Legacy JWT secret" (HS256). Projetos novos (chaves assimétricas) deixam vazio.
SUPABASE_JWT_SECRET=
# service_role: SÓ no servidor (excluir conta, URLs assinadas do Storage). Nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase > Connect > Session pooler (JDBC) — também usado por `npm run banco` ---
SUPABASE_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.SEU-PROJETO
SUPABASE_DB_PASSWORD=sua-senha-do-banco

CORS_ORIGENS=http://localhost:5173

# --- NutriBot (CE-21) ---
ANTHROPIC_API_KEY=
# Modelo do NutriBot (troque sem recompilar). Padrão: claude-sonnet-5-5 (mais rápido no chat ao vivo)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Provedor do NutriBot: anthropic (padrão, precisa de crédito na API) ou gemini (camada gratuita do Google AI Studio)
NUTRIBOT_PROVEDOR=anthropic
GEMINI_API_KEY=
# Modelos tentados em ordem; se um estiver em "alta demanda" na camada gratuita, o seguinte responde
GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash

# --- E-mail da prescrição (CE-20): Resend (preferido) ou SMTP ---
RESEND_API_KEY=
EMAIL_REMETENTE=CleanEats <onboarding@resend.dev>
# Modo demo: todo e-mail vai para este endereço (os e-mails @cleaneats.test não existem)
EMAIL_REDIRECIONAR_PARA=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
